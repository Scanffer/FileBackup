{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw-release",
      "displayName": "MinGW x64 Release（单 exe 交付）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW x64 Debug",
      "inherits": "mingw-release",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" }
  ]
}
