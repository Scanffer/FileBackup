# ---- 构建产物（CMakePresets.json 的 binaryDir） ----
# 只忽略**仓库根目录**的 build/、out/：不带前导斜杠的 `build/` 会匹配任意
# 层级的同名目录，曾把 third_party/zstd/build（上游 CMake 脚本）漏出仓库，
# 造成「本机能编、clone 下来 configure 必失败」。见 third_party/CMakeLists.txt。
/build/
/out/
cmake-build-*/

# ---- 编译/链接中间产物 ----
*.obj
*.o
*.a
*.exe
*.dll
# 例外：WebView2 的引导 DLL 是 vendored 依赖（会被编进 exe 资源段），
# 必须随源码提交，否则新组员 clone 下来构建出的 exe 在运行时找不到 loader。
!third_party/webview2/WebView2Loader.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.res
*.tlog
*.log

# ---- IDE ----
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
*.user
*.suo
*.sln
*.vcxproj*

# ---- Python（tools/embed_web.py 等） ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 编辑器/工具本地配置 ----
.claude/
.idea/

# ---- 本地工作文件（AI 开发计划等，不提交） ----
/step.md

# ---- 运行时产物 ----
*.vbak
backup-*/
.restore-tmp/

# ---- 本地测试残留 ----
/.filebackup_test_tmp/
/test_src/ 
/test_bak/
/test_restore/
/测试源/ 
/测试备份/
# 镜像/打包测试产物
/test_mirror*/
/test_unpack*/
*.vbak

/md