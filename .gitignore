# ---- 构建产物（CMakePresets.json 的 binaryDir） ----
build/
out/
cmake-build-*/

# ---- 编译/链接中间产物 ----
*.obj
*.o
*.a
*.exe
*.dll
# 例外：WebView2 的引导 DLL 是 vendored 依赖（会被编进 exe 资源段），
# 必须随源码提交，否则新组员 clone 下来构建出的 exe 在运行时找不到 loader。
!third_party/webview2/WebView2Loader.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.res
*.tlog
*.log

# ---- IDE ----
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
*.user
*.suo
*.sln
*.vcxproj*

# ---- Python（tools/embed_web.py 等） ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 编辑器/工具本地配置 ----
.claude/
.idea/

# ---- 运行时产物 ----
*.vbak
backup-*/
.restore-tmp/

# ---- 本地测试残留 ----
/test_src/ 
/test_bak/
/test_restore/
/测试源/ 
/测试备份/
# 镜像/打包测试产物
/test_mirror*/
/test_unpack*/
*.vbak